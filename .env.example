# Anthropic API key — only needed if you call labeling.label_via_api().
# For the manual / Claude-Code-in-conversation labeling workflow this is unused.
ANTHROPIC_API_KEY=

# Override the labeling model. Default is claude-opus-4-7.
ANTHROPIC_MODEL=claude-opus-4-7

# SimSat base URL. Default is the local Docker compose deployment.
SIMSAT_BASE_URL=http://localhost:9005
